<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 版本只在这里指定一次 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>men.sbb8</groupId>
    <artifactId>ss-cloud</artifactId>
    <version>2026.10.21.0</version>
    <packaging>pom</packaging>
    <name>ss-cloud</name>
    <description>ss-cloud 顶层 POM：统一管理 Java、Spring Boot、Spring Cloud 及第三方依赖版本</description>

    <modules>
        <module>ss-common</module>
        <module>ss-web-starter</module>
        <module>ss-grpc-starter</module>
    </modules>

    <properties>
        <java.version>25</java.version>

        <!-- 2025.1.2 起兼容 Spring Boot 4.1，不要低于此版本 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>

        <springdoc.version>3.1.1</springdoc.version>
        <mybatis.version>3.5.19</mybatis.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud：目前只管理版本，不引入任何 Spring Cloud 依赖 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-web-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-grpc-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot BOM 之外的第三方依赖 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- 版本由 Spring Boot BOM 的 dependencyManagement 提供（compiler-plugin 3.12+） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
