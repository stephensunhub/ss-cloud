<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 版本只在这里指定一次 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>men.sbb8</groupId>
    <artifactId>ss-cloud</artifactId>
    <version>2026.10.21.0</version>
    <packaging>pom</packaging>
    <name>ss-cloud</name>
    <description>ss-cloud 顶层 POM：统一管理 Java、Spring Boot、Spring Cloud 及第三方依赖版本</description>

    <modules>
        <module>ss-web-starter</module>
        <module>ss-grpc-core</module>
        <module>ss-grpc-server-starter</module>
        <module>ss-grpc-client-starter</module>
    </modules>

    <properties>
        <java.version>25</java.version>

        <!-- Spring Cloud 列车。官方 Supported Versions：2025.1（Oakwood）对应 Spring Boot 4.0.x，其 BOM 全部基于 4.0.x 构建；
             下一条列车 2026.0 对应 Boot 4.2。目前没有正式对应 Boot 4.1 的列车，本项目是 Boot 4.1.1。
             现在没有任何模块使用 Spring Cloud 组件；引入 Consul 等组件前，先实测与当前 Boot 的兼容性，或让 Boot 与列车对齐 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>

        <springdoc.version>3.1.1</springdoc.version>
        <mybatis.version>3.5.19</mybatis.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud：目前只管理版本，不引入任何 Spring Cloud 依赖 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-web-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-grpc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-grpc-server-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-grpc-client-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot BOM 之外的第三方依赖 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- 版本由 Spring Boot BOM 的 dependencyManagement 提供（compiler-plugin 3.12+） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                            <!-- 生成 META-INF/spring-autoconfigure-metadata.properties：启动时无需加载自动配置类，就能按条件预过滤 -->
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-autoconfigure-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito 把自己作为 -javaagent 加载，而不是运行时自附加到 JVM（后者在以后的 JDK 里会被禁止，现在就会打警告）；
                             -Xshare:off 去掉"类数据共享"因追加了 agent 而打印的警告 -->
                        <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar -Xshare:off</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
