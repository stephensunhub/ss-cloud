<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 版本只在这里指定一次 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>men.sbb8</groupId>
    <artifactId>ss-cloud</artifactId>
    <version>2026.11.18.0</version>
    <packaging>pom</packaging>
    <name>ss-cloud</name>
    <description>ss-cloud 顶层 POM：统一管理 Java、Spring Boot、Spring Cloud 及第三方依赖版本</description>

    <!-- 发布目标：自建 Maven 私服 https://maven.sbb8.men（Reposilite，匿名可读，写入需要令牌）；
         认证见 ~/.m2/settings.xml 里 id 为 sbb8-maven 的 server，具体做法见 README"发布" -->
    <distributionManagement>
        <repository>
            <id>sbb8-maven</id>
            <name>sbb8 Maven Releases</name>
            <url>https://maven.sbb8.men/releases</url>
        </repository>
        <snapshotRepository>
            <id>sbb8-maven</id>
            <name>sbb8 Maven Snapshots</name>
            <url>https://maven.sbb8.men/snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <modules>
        <module>ss-web-starter</module>
        <module>ss-grpc-core</module>
        <module>ss-grpc-server-starter</module>
        <module>ss-grpc-client-starter</module>
    </modules>

    <properties>
        <java.version>25</java.version>

        <!-- Spring Cloud 列车。官方 Supported Versions：2025.1（Oakwood）对应 Spring Boot 4.0.x，其 BOM 全部基于 4.0.x 构建；
             下一条列车 2026.0 对应 Boot 4.2。目前没有基于 Boot 4.1 构建的列车，本项目是 Boot 4.1.2；
             但 2025.1.3 的 spring-cloud-commons 5.0.3 启动时的版本校验（CompatibilityVerifier）接受 4.0.x 和 4.1.x，
             2026.0.0-M1 只接受 4.2.x（Boot 4.1.1 上直接启动失败），所以升级 Boot 到 4.2 时要同步升级列车。
             本仓库的 starter 不依赖 Spring Cloud（只有 ss-web-starter 的测试用到 spring-cloud-starter-loadbalancer），
             这个版本供继承本 POM 的应用引入 Spring Cloud 组件时使用。已在 Boot 4.1.1 上实测 Spring Cloud LoadBalancer
             和 Spring Cloud Consul 5.0.3 的 JVM 模式可用；引入其他组件前先实测兼容性，或让 Boot 与列车对齐 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>

        <springdoc.version>3.1.1</springdoc.version>
        <mybatis.version>3.5.19</mybatis.version>
        <!-- 分布式锁。已在 Boot 4.1.2 + GraalVM 25 的原生镜像上验证 RLock、可重入、看门狗续期、读写锁（需要 SsWebRuntimeHints 里的 Netty 反射提示） -->
        <redisson.version>4.8.0</redisson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud：只管理版本，供应用引入 Spring Cloud 组件时使用，starter 本身不依赖它们 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-web-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-grpc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-grpc-server-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>men.sbb8</groupId>
                <artifactId>ss-grpc-client-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot BOM 之外的第三方依赖 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- 框架开销基准不参与默认构建：-Pbenchmark 才会加入（也包括 IDE 导入、versions:set 时），用法见 ss-benchmark/README.md -->
        <profile>
            <id>benchmark</id>
            <modules>
                <module>ss-benchmark</module>
            </modules>
        </profile>
    </profiles>

    <dependencies>
        <!-- 仅编译期使用（注解处理器）：provided 不进运行时、不传递；写在这里，所有子模块自动继承，不用各自声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- 版本由 Spring Boot BOM 的 dependencyManagement 提供（compiler-plugin 3.12+） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                            <!-- 生成 META-INF/spring-autoconfigure-metadata.properties：启动时无需加载自动配置类，就能按条件预过滤 -->
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-autoconfigure-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito 把自己作为 -javaagent 加载，而不是运行时自附加到 JVM（后者在以后的 JDK 里会被禁止，现在就会打警告）；
                             -Xshare:off 去掉"类数据共享"因追加了 agent 而打印的警告 -->
                        <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar -Xshare:off</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
